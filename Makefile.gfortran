objects = aver.o cpu_intel.o input.o forces.o main.o mdee.o mdstep.o \
       restart.o scalar.o service.o setup.o util.o 

   FC = gfortran  
   FFLAGS = -O3 -ffast-math
   LDFLAGS = 
   TARGET = md

default: $(objects) 
	$(FC) $(LDFLAGS) -o $(TARGET) $(objects)
   $(objects) : common_inc.f dimpar.h

clean: 
	rm -f $(TARGET) *.o
